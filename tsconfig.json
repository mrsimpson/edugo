{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "schemas/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "uno.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "docs/.vitepress"
  ]
}
